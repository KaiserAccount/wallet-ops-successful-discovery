# Direct Postgres. On Railway use the session pooler (IPv4), not db.<ref>.supabase.co.
# Copy the host from the Supabase Connect dialog (Session pooler). The cluster
# index is not always aws-0. This project (trzfysszmrgogpeitzfk, us-west-2)
# lives on aws-0; aws-1 returns tenant/user not found.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Preferred on Railway (same shape as wallet_ops_archive). Port 5432 is session mode.
# Do not use port 6543 (transaction mode). User must be <role>.<project-ref>, not bare postgres.
# SUPABASE_HOST=aws-0-us-west-2.pooler.supabase.com
# SUPABASE_PORT=5432
# SUPABASE_USER=postgres.trzfysszmrgogpeitzfk
# SUPABASE_PASSWORD=
# SUPABASE_DBNAME=postgres
# Same password, alternate name accepted by the matrix and by discover.py.
# SUPABASE_DB_PASSWORD=

# CONNECT_MODE selects the dial policy discover.py uses after a matrix PASS.
# session-pooler (default): port 5432, user role.ref, IPv4 A-record failover.
# transaction-pooler: allows port 6543 (session state may not stick).
# direct: db.<ref>.supabase.co over IPv4, or IPv6 when the name has no A record.
# direct-ipv6: AAAA only.
# CONNECT_MODE=session-pooler

# Optional overrides for connect_matrix.py. Region defaults to us-west-2.
# An https://<ref>.supabase.co value is the HTTP API, not a Postgres host.
# SUPABASE_PROJECT_REF=trzfysszmrgogpeitzfk
# SUPABASE_REGION=us-west-2
# SUPABASE_URL=https://trzfysszmrgogpeitzfk.supabase.co

SOLANA_TRACKER_API_KEY=

# One-shot test label. Unset (normal cron): harvest the top ROI quintile and exit.
# 1/true/yes: same harvest, but logs mode=test / ONE-SHOT TEST.
# On Railway: set DISCOVER_TEST=1 and redeploy. See RAILWAY.md.
# Cron does not need this variable. PYTHONUNBUFFERED=1 is set in the image
# so stdout progress lines show up immediately. Set it locally too.
# DISCOVER_TEST=
# Deprecated alias of DISCOVER_TEST. Same truthy values. Does not gate cron.
# DISCOVER_SMOKE=

# Leading fraction of distinct tokens inside the rolling window. Default 0.20.
# 1 harvests the whole ranked window. 20 and 20% are the same as 0.20.
# DISCOVER_TOP_FRACTION=0.20

# Only outcomes with detected_at inside this many hours are ranked. Default 10.
# The cron stays every 8 hours. 10h and 10 are the same.
# DISCOVER_WINDOW_HOURS=10

# 1/true/yes: harvest mints already ledgered ok or empty. Unset skips them.
# A token_trader_scans row with status=error is retried either way.
# DISCOVER_RESCAN=

# One-shot connect matrix. 1/true/yes: try the host/port/user/address matrix,
# print a WINNER line on the first SELECT 1, and exit. No Tracker call and no
# harvest. Clear the Railway cron before setting this, then unset it before
# putting the cron back. See RAILWAY.md.
# MATRIX_RUN=
# MATRIX_ENUMERATE=1 prints the matrix and does not dial.
# MATRIX_CONNECT_TIMEOUT=12

# Optional: scan this mint instead of the top quintile. Skips ok/empty unless DISCOVER_RESCAN.
# DISCOVER_MINT=
